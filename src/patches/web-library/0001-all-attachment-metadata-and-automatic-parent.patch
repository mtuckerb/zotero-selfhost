@@ -0,0 +1,61 @@
+@use "../../abstracts/mixins/breakpoints";
+
+.metadata-refresh-modal {
+	@include breakpoints.mouse-and-bp-up(md) {
+		width: min(880px, calc(100vw - 48px));
+	}
+
+	.modal-body {
+		min-height: 180px;
+	}
+
+	.metadata-refresh-status {
+		display: flex;
+		gap: 8px;
+		align-items: center;
+		justify-content: center;
+		min-height: 140px;
+	}
+
+	.metadata-refresh-table-wrap {
+		max-height: min(58vh, 520px);
+		overflow: auto;
+	}
+
+	.metadata-refresh-table {
+		width: 100%;
+		border-collapse: collapse;
+		table-layout: fixed;
+
+		th,
+		td {
+			padding: 8px;
+			border-bottom: 1px solid var(--fill-quinary);
+			vertical-align: top;
+			text-align: left;
+			overflow-wrap: anywhere;
+			white-space: pre-wrap;
+		}
+
+		th:first-child,
+		td:first-child {
+			width: 76px;
+			text-align: center;
+		}
+
+		th:nth-child(2),
+		td:nth-child(2) {
+			width: 140px;
+		}
+	}
+
+	.metadata-refresh-empty {
+		color: var(--fill-secondary);
+		font-style: italic;
+	}
+
+	.modal-footer-right {
+		display: flex;
+		gap: 8px;
+	}
+}
