+import { strFromU8, unzipSync } from 'fflate';
+import { omit } from 'web-common/utils';
+import { getZotero } from 'web-common/zotero';
+import { getItemFromIdentifier } from './identifiers';
+
+const MAX_FILE_BYTES = 64 * 1024 * 1024;
+const MAX_METADATA_BYTES = 2 * 1024 * 1024;
+const DC = 'http://purl.org/dc/elements/1.1/';
+const REFRESH_PROTECTED_FIELDS = new Set([
+	'key', 'version', 'dateAdded', 'dateModified', 'collections', 'relations', 'tags',
+	'attachments', 'notes', 'parentItem', 'deleted',
+]);
+
+// Recognition creates a parent. Never detach an attachment from an existing one.
+export const canRetrieveAttachmentMetadata = item => item?.itemType === 'attachment'
+	&& !item.parentItem && !item.deleted;
+
+const linkedAttachmentKey = parentItem => parentItem?.[Symbol.for('links')]
+	?.attachment?.href?.split('/').filter(Boolean).pop() || null;
+
+export const attachmentFormat = item => {
+	const type = (item.contentType || '').split(';')[0].toLowerCase();
+	const ext = (item.filename || '').split('.').pop().toLowerCase();
+	if (type === 'application/pdf' || ext === 'pdf') return 'pdf';
+	if (type === 'application/epub+zip' || ext === 'epub') return 'epub';
+	if (type === 'text/html' || type === 'application/xhtml+xml' || ['html', 'htm', 'xhtml'].includes(ext)) return 'html';
+	if (type.includes('officedocument.wordprocessingml') || ext === 'docx') return 'docx';
+	if (type === 'application/vnd.oasis.opendocument.text' || ext === 'odt') return 'odt';
+	if (type.startsWith('text/') || ['txt', 'md', 'csv'].includes(ext)) return 'text';
+	return 'other';
+};
+
+export const findMetadataAttachment = (parentItem, items = {}) => {
+	if (!parentItem || ['attachment', 'note', 'annotation'].includes(parentItem.itemType)) return null;
+	const linkedKey = linkedAttachmentKey(parentItem);
+	const linkedAttachment = linkedKey && items[linkedKey];
+	if (linkedAttachment?.itemType === 'attachment' && linkedAttachment.parentItem === parentItem.key && !linkedAttachment.deleted) {
+		return linkedAttachment;
+	}
+	const rank = { pdf: 0, epub: 1, html: 2, docx: 3, odt: 4, text: 5, other: 6 };
+	return Object.values(items)
+		.filter(item => item?.itemType === 'attachment' && item.parentItem === parentItem.key && !item.deleted)
+		.sort((a, b) => rank[attachmentFormat(a)] - rank[attachmentFormat(b)])[0] || null;
+};
+
+export const getMetadataAttachmentKey = (parentItem, items = {}) => {
+	if (!parentItem || ['attachment', 'note', 'annotation'].includes(parentItem.itemType)) return null;
+	return linkedAttachmentKey(parentItem) || findMetadataAttachment(parentItem, items)?.key || null;
+};
+
+const isEmptyMetadataValue = value => value === undefined || value === null || value === ''
+	|| (Array.isArray(value) && value.length === 0);
+const stableMetadataValue = value => {
+	if (Array.isArray(value)) return value.map(stableMetadataValue);
+	if (value && typeof value === 'object') return Object.fromEntries(
+		Object.keys(value).sort().map(key => [key, stableMetadataValue(value[key])])
+	);
+	return value;
+};
+const comparableMetadataValue = value => isEmptyMetadataValue(value) ? null : JSON.stringify(stableMetadataValue(value));
+
+export const buildMetadataRefreshChanges = (currentItem, candidate) => {
+	const priority = ['itemType', 'title', 'creators'];
+	const fields = [...new Set([
+		...priority,
+		...Object.keys(currentItem || {}),
+		...Object.keys(candidate || {}),
+	])].filter(field => !REFRESH_PROTECTED_FIELDS.has(field));
+	return fields.flatMap(field => {
+		const currentValue = currentItem?.[field];
+		const newValue = candidate?.[field];
+		if (comparableMetadataValue(currentValue) === comparableMetadataValue(newValue)) return [];
+		return [{
+			field, currentValue, newValue,
+			useNewByDefault: isEmptyMetadataValue(currentValue) && !isEmptyMetadataValue(newValue),
+		}];
+	});
+};
+
+export const buildMetadataRefreshPatch = (changes, selectedFields) => Object.fromEntries(
+	changes.filter(change => selectedFields.has(change.field)).map(change => [
+		change.field,
+		change.newValue === undefined || change.newValue === null
+			? (Array.isArray(change.currentValue) ? [] : '')
+			: change.newValue,
+	])
+);
+
+const parseXML = text => {
+	const doc = new DOMParser().parseFromString(text, 'application/xml');
+	if (doc.getElementsByTagName('parsererror').length) {
+		throw new Error('Could not read the file’s embedded metadata. Use Create Parent Item for manual entry.');
+	}
+	return doc;
+};
+const values = (doc, name) => [...doc.getElementsByTagNameNS(DC, name)]
+	.map(node => node.textContent.trim()).filter(Boolean);
+const creator = (name, creatorType = 'author') => getZotero().Utilities.cleanAuthor(name, creatorType, name.includes(','));
+
+// Extract only the requested metadata, never decompress the whole archive.
+const readZipText = (bytes, name) => {
+	const entries = unzipSync(bytes, { filter: entry => {
+		if (entry.name !== name) return false;
+		if (entry.originalSize > MAX_METADATA_BYTES) throw new Error('Embedded metadata is too large to read automatically.');
+		return true;
+	} });
+	return entries[name] ? strFromU8(entries[name]) : null;
+};
+
+export const extractEmbeddedMetadata = (data, format) => {
+	const bytes = new Uint8Array(data);
+	if (bytes.byteLength > MAX_FILE_BYTES) throw new Error('File is too large for automatic metadata extraction. Use an identifier or manual entry.');
+	if (['epub', 'docx', 'odt'].includes(format)) {
+		let name = format === 'docx' ? 'docProps/core.xml' : 'meta.xml';
+		if (format === 'epub') {
+			const container = readZipText(bytes, 'META-INF/container.xml');
+			if (!container) throw new Error('This EPUB has no metadata container. Use an identifier or manual entry.');
+			name = parseXML(container).getElementsByTagNameNS('*', 'rootfile')[0]?.getAttribute('full-path');
+		}
+		const text = name && readZipText(bytes, name);
+		if (!text) {
+			if (format === 'epub') throw new Error('This EPUB’s metadata package is missing. Use an identifier or manual entry.');
+			return { metadata: {}, identifierText: '' };
+		}
+		const doc = parseXML(text);
+		const metadata = {
+			itemType: format === 'epub' ? 'book' : 'document',
+			title: values(doc, 'title')[0],
+			creators: values(doc, 'creator').map(name => creator(name)),
+			language: values(doc, 'language')[0],
+			abstractNote: values(doc, 'description')[0],
+		};
+		if (format === 'epub') {
+			metadata.publisher = values(doc, 'publisher')[0];
+			metadata.date = values(doc, 'date')[0];
+			metadata.ISBN = getZotero().Utilities.extractIdentifiers(values(doc, 'identifier').join('\n')).find(id => id.ISBN)?.ISBN;
+			metadata.creators = [...doc.getElementsByTagNameNS(DC, 'creator')].map(node => {
+				const role = node.getAttributeNS('http://www.idpf.org/2007/opf', 'role')
+					|| [...doc.getElementsByTagNameNS('*', 'meta')].find(meta =>
+						meta.getAttribute('refines') === `#${node.id}` && meta.getAttribute('property') === 'role')?.textContent.trim();
+				return creator(node.textContent.trim(), role === 'trl' ? 'translator' : role === 'edt' ? 'editor' : 'author');
+			});
+		}
+		return { metadata, identifierText: values(doc, 'identifier').join('\n') };
+	}
+	const text = strFromU8(bytes).slice(0, MAX_METADATA_BYTES);
+	if (format === 'html') {
+		// DOMParser creates an inert document; never mount file markup in the page.
+		const doc = new DOMParser().parseFromString(text, 'text/html');
+		const meta = (...names) => [...doc.querySelectorAll('meta')]
+			.filter(node => names.includes((node.getAttribute('name') || node.getAttribute('property') || '').toLowerCase()))
+			.map(node => node.getAttribute('content')?.trim()).filter(Boolean);
+		const journal = meta('citation_journal_title')[0];
+		return {
+			metadata: {
+				itemType: journal ? 'journalArticle' : 'webpage',
+				title: meta('citation_title', 'dc.title', 'og:title')[0] || doc.title || undefined,
+				creators: meta('citation_author', 'dc.creator', 'author').map(name => creator(name)),
+				date: meta('citation_publication_date', 'dc.date')[0],
+				language: doc.documentElement.lang || undefined,
+				...(journal ? { publicationTitle: journal } : {}),
+			},
+			identifierText: meta('citation_doi', 'citation_isbn', 'dc.identifier').join('\n'),
+		};
+	}
+	return { metadata: {}, identifierText: text };
+};
+
+export const basicAttachmentMetadata = attachment => {
+	const type = attachment.contentType || '';
+	const format = attachmentFormat(attachment);
+	const itemType = format === 'epub' ? 'book' : format === 'html' || attachment.linkMode === 'linked_url' ? 'webpage'
+		: type.startsWith('image/') ? 'artwork' : type.startsWith('audio/') ? 'audioRecording'
+			: type.startsWith('video/') ? 'videoRecording' : 'document';
+	const title = (attachment.title || attachment.filename || '').trim();
+	return {
+		itemType,
+		title: title === attachment.filename ? title.replace(/\.[^.]+$/, '') : title,
+		...(attachment.url ? { url: attachment.url } : {}),
+	};
+};
+
+export const supplementWeakPDFMetadata = (attachment, pdfMetadata = {}, recognizedItem) => {
+	const hasBibliographicMetadata = recognizedItem && (
+		recognizedItem.creators?.length
+		|| ['DOI', 'ISBN', 'ISSN', 'publicationTitle', 'bookTitle', 'publisher', 'date', 'url']
+			.some(field => recognizedItem[field])
+	);
+	if (hasBibliographicMetadata) return { metadata: recognizedItem, warning: null };
+	const author = (pdfMetadata.Author || '').trim();
+	const creators = !author || /^(?:none|unknown|anonymous)$/i.test(author) ? [] : author
+		.split(/\s*;\s*/).filter(Boolean).map(name => {
+			const corporate = !name.includes(',') && (name.split(/\s+/).length === 1 || /^[A-Z0-9& .'-]+$/.test(name));
+			return corporate ? { creatorType: 'author', name } : creator(name);
+		});
+	const embedded = Object.fromEntries(Object.entries({
+		itemType: 'document',
+		title: pdfMetadata.Title?.trim(),
+		creators,
+		abstractNote: pdfMetadata.Subject?.trim(),
+		language: pdfMetadata.Language?.trim(),
+		publisher: pdfMetadata.EBX_PUBLISHER?.trim(),
+	}).filter(([, value]) => value !== undefined && value !== ''));
+	const remote = Object.fromEntries(Object.entries(omit(recognizedItem || {}, ['itemType', 'creators']))
+		.filter(([, value]) => value !== undefined && value !== ''));
+	const metadata = { ...basicAttachmentMetadata(attachment), ...embedded, ...remote, itemType: 'document', creators };
+	return { metadata, warning: 'From embedded PDF metadata; review details' };
+};
+
+const titleMatchScore = (reference, candidate) => {
+	const words = value => new Set(String(value || '').normalize('NFKD').toLowerCase()
+		.replace(/[\u0300-\u036f]/g, '').match(/[\p{L}\p{N}]+/gu) || []);
+	const expected = words(reference);
+	const actual = words(candidate);
+	if (!expected.size || !actual.size) return 0;
+	const overlap = [...expected].filter(word => actual.has(word)).length;
+	return (2 * overlap) / (expected.size + actual.size);
+};
+
+export const retrieveNonPDFMetadata = async (attachment, { readFile, translateUrl }) => {
+	const format = attachmentFormat(attachment);
+	let embedded = { metadata: {}, identifierText: '' };
+	if (['epub', 'html', 'docx', 'odt', 'text'].includes(format)
+		&& ['imported_file', 'imported_url'].includes(attachment.linkMode)) {
+		embedded = extractEmbeddedMetadata(await readFile(), format);
+	}
+	const text = [embedded.identifierText, attachment.url, attachment.title, attachment.filename].filter(Boolean).join('\n');
+	const identifiers = getZotero().Utilities.extractIdentifiers(text)
+		// Bare eight-digit filenames are not evidence of PubMed records.
+		.filter(id => !id.PMID || /(?:PMID\s*:?|pubmed\.ncbi\.nlm\.nih\.gov\/)/i.test(text))
+		.filter((identifier, index, all) => {
+			const value = JSON.stringify(identifier);
+			return all.findIndex(other => JSON.stringify(other) === value) === index;
+		});
+	const referenceTitle = embedded.metadata.title || basicAttachmentMetadata(attachment).title;
+	let bestMatch = null;
+	for (const identifier of identifiers.slice(0, 5)) {
+		try {
+			const [kind, value] = Object.entries(identifier)[0];
+			const item = await getItemFromIdentifier(`${kind}: ${value}`, translateUrl);
+			if (item?.title && item.itemType && !['attachment', 'note', 'annotation'].includes(item.itemType)) {
+				// Translation results may carry attachment suggestions; the original file is retained.
+				const metadata = omit(item, ['key', 'version', 'attachments', 'notes']);
+				const score = titleMatchScore(referenceTitle, metadata.title);
+				if (!bestMatch || score > bestMatch.score) bestMatch = { metadata, score };
+				// An exact title match cannot be improved by later identifiers.
+				if (score === 1) break;
+			}
+		} catch {
+			// Embedded fields remain useful when the lookup service is unavailable.
+		}
+	}
+	if (bestMatch) return { metadata: bestMatch.metadata, warning: null };
+	const basic = basicAttachmentMetadata(attachment);
+	const fields = Object.fromEntries(Object.entries(embedded.metadata).filter(([, value]) => value !== undefined && value !== ''));
+	const metadata = { ...basic, ...fields, title: fields.title || basic.title };
+	if (!metadata.title) throw new Error('No title or metadata found. Use Create Parent Item for manual entry.');
+	return {
+		metadata,
+		warning: fields.title ? 'From embedded metadata; review details' : 'From file details; review and complete metadata',
+	};
+};
