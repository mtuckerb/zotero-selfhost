diff --git a/test/attachment-metadata.test.js b/test/attachment-metadata.test.js
new file mode 100644
index 00000000..ad47110b
--- /dev/null
+++ b/test/attachment-metadata.test.js
@@ -0,0 +1,174 @@
+import { zipSync, strToU8 } from 'fflate';
+import { configureZoteroShim } from 'web-common/zotero';
+import schema from 'zotero-schema/schema.json';
+import {
+ attachmentFormat, buildMetadataRefreshChanges, buildMetadataRefreshPatch,
+ canRetrieveAttachmentMetadata, extractEmbeddedMetadata, findMetadataAttachment, getMetadataAttachmentKey,
+ retrieveNonPDFMetadata
+} from '../src/js/common/attachment-metadata';
+import { getItemFromIdentifier } from '../src/js/common/identifiers';
+
+jest.mock('../src/js/common/identifiers');
+const xml = '<metadata xmlns:dc="http://purl.org/dc/elements/1.1/"><dc:title>The Diving Bell and the Butterfly</dc:title><dc:creator>Jean-Dominique Bauby</dc:creator><dc:publisher>Knopf Doubleday Publishing Group</dc:publisher><dc:date>2008-03-06</dc:date><dc:identifier>9780307454836</dc:identifier><dc:language>en</dc:language></metadata>';
+const epub = () => zipSync({
+ 'META-INF/container.xml': strToU8('<container xmlns="urn:oasis:names:tc:opendocument:xmlns:container"><rootfiles><rootfile full-path="BOOK/book.opf"/></rootfiles></container>'),
+ 'BOOK/book.opf': strToU8(xml),
+ 'BOOK/cover.jpg': new Uint8Array(32),
+});
+const attachment = { itemType: 'attachment', linkMode: 'imported_file', contentType: 'application/epub+zip', title: 'book.epub', filename: 'book.epub' };
+beforeEach(() => {
+ configureZoteroShim(schema, { locale: 'en-US', formatMessage: ({ id }) => id });
+ getItemFromIdentifier.mockReset();
+});
+
+test('reads EPUB metadata and ISBN from the declared package', () => {
+ const result = extractEmbeddedMetadata(epub(), 'epub');
+ expect(result.metadata).toMatchObject({ itemType: 'book', title: 'The Diving Bell and the Butterfly', publisher: 'Knopf Doubleday Publishing Group', date: '2008-03-06', language: 'en', creators: [{ firstName: 'Jean-Dominique', lastName: 'Bauby', creatorType: 'author' }] });
+ expect(result.identifierText).toBe('9780307454836');
+});
+
+test('uses an ISBN lookup and excludes suggested additional attachments', async () => {
+ getItemFromIdentifier.mockResolvedValue({ itemType: 'book', title: 'Catalog title', attachments: [{}], notes: [{}] });
+ const result = await retrieveNonPDFMetadata(attachment, { readFile: async () => epub(), translateUrl: '/translate' });
+ expect(getItemFromIdentifier).toHaveBeenCalledWith('ISBN: 9780307454836', '/translate');
+ expect(result).toEqual({ metadata: { itemType: 'book', title: 'Catalog title' }, warning: null });
+});
+
+test('retains embedded book fields when lookup fails or returns no result', async () => {
+ for (const response of [undefined, { itemType: 'attachment', title: 'not a parent' }]) {
+  getItemFromIdentifier.mockResolvedValue(response);
+  const result = await retrieveNonPDFMetadata(attachment, { readFile: async () => epub(), translateUrl: '/translate' });
+  expect(result.metadata.title).toBe('The Diving Bell and the Butterfly');
+  expect(result.warning).toContain('embedded metadata');
+ }
+ getItemFromIdentifier.mockRejectedValue(new Error('offline'));
+ expect((await retrieveNonPDFMetadata(attachment, { readFile: async () => epub() })).metadata.itemType).toBe('book');
+});
+
+test('reads DOCX and ODT metadata without treating file creation time as publication date', () => {
+ for (const [format, path] of [['docx', 'docProps/core.xml'], ['odt', 'meta.xml']]) {
+  const result = extractEmbeddedMetadata(zipSync({ [path]: strToU8(xml) }), format);
+  expect(result.metadata.itemType).toBe('document');
+  expect(result.metadata.creators[0].lastName).toBe('Bauby');
+  expect(result.metadata.date).toBeUndefined();
+ }
+});
+
+test('reads HTML citation metadata and does not execute scripts', () => {
+ const result = extractEmbeddedMetadata(strToU8('<html><head><meta name="citation_title" content="Research"><meta name="citation_author" content="Ada Lovelace"><meta name="citation_doi" content="10.1234/example"><meta name="citation_journal_title" content="Journal"><script>window.metadataScriptRan=true</script></head></html>'), 'html');
+ expect(result.metadata).toMatchObject({ title: 'Research', itemType: 'journalArticle', publicationTitle: 'Journal' });
+ expect(result.identifierText).toBe('10.1234/example');
+ expect(window.metadataScriptRan).toBeUndefined();
+});
+
+test('all other types get a labeled basic parent without downloading binary content', async () => {
+ const readFile = jest.fn();
+ for (const [contentType, filename, itemType] of [['image/png', 'Drawing.png', 'artwork'], ['audio/mpeg', 'Interview.mp3', 'audioRecording'], ['video/mp4', 'Lecture.mp4', 'videoRecording'], ['application/octet-stream', 'Archive.bin', 'document']]) {
+  const result = await retrieveNonPDFMetadata({ ...attachment, contentType, filename, title: filename }, { readFile });
+  expect(result.metadata).toEqual({ itemType, title: filename.replace(/\.[^.]+$/, '') });
+  expect(result.warning).toContain('file details');
+ }
+ expect(readFile).not.toHaveBeenCalled();
+});
+
+test('linked files and URLs use available identifiers without trying browser file access', async () => {
+ const readFile = jest.fn();
+ getItemFromIdentifier.mockResolvedValue({ itemType: 'book', title: 'Matched book' });
+ const result = await retrieveNonPDFMetadata({ ...attachment, linkMode: 'linked_file', filename: '9780307454836.epub' }, { readFile });
+ expect(result.metadata.title).toBe('Matched book');
+ expect(readFile).not.toHaveBeenCalled();
+});
+
+test('does not mistake an eight digit filename for a PubMed identifier', async () => {
+ const result = await retrieveNonPDFMetadata({ ...attachment, contentType: 'image/jpeg', filename: '20260925.jpg', title: '20260925.jpg' }, {});
+ expect(result.metadata.title).toBe('20260925');
+ expect(getItemFromIdentifier).not.toHaveBeenCalled();
+});
+
+test('chooses the identifier result that best matches the document instead of the first citation', async () => {
+ const paper = {
+  ...attachment,
+  contentType: 'text/markdown',
+  title: 'Housing First and Recovery Outcomes.md',
+  filename: 'Housing First and Recovery Outcomes.md',
+ };
+ getItemFromIdentifier.mockImplementation(identifier => Promise.resolve(
+  identifier.includes('10.1000/incidental')
+   ? { itemType: 'journalArticle', title: 'An Incidental Work Cited in the Paper', DOI: '10.1000/incidental' }
+   : { itemType: 'journalArticle', title: 'Housing First and Recovery Outcomes', DOI: '10.2000/target' }
+ ));
+ const result = await retrieveNonPDFMetadata(paper, {
+  readFile: async () => strToU8('# Housing First and Recovery Outcomes\n\nPrior work (10.1000/incidental) informed this study.\n\nDOI: 10.2000/target'),
+  translateUrl: '/translate',
+ });
+ expect(getItemFromIdentifier).toHaveBeenCalledTimes(2);
+ expect(result.metadata).toMatchObject({ title: 'Housing First and Recovery Outcomes', DOI: '10.2000/target' });
+});
+
+test('bad EPUB packages and invalid XML fail with useful errors instead of creating false metadata', () => {
+ expect(() => extractEmbeddedMetadata(strToU8('not a zip'), 'epub')).toThrow();
+ expect(() => extractEmbeddedMetadata(zipSync({}), 'epub')).toThrow('metadata container');
+ const bad = zipSync({ 'META-INF/container.xml': strToU8('<invalid') });
+ expect(() => extractEmbeddedMetadata(bad, 'epub')).toThrow('embedded metadata');
+});
+
+test('rejects oversized metadata before decompressing it', () => {
+ const archive = zipSync({ 'docProps/core.xml': strToU8('x'.repeat(2 * 1024 * 1024 + 1)) });
+ expect(() => extractEmbeddedMetadata(archive, 'docx')).toThrow('too large');
+});
+
+test('detects mislabeled EPUBs by extension; existing parents, notes, and deleted items are excluded', () => {
+ expect(attachmentFormat({ ...attachment, contentType: 'application/octet-stream' })).toBe('epub');
+ expect(canRetrieveAttachmentMetadata(attachment)).toBe(true);
+ expect(canRetrieveAttachmentMetadata({ ...attachment, parentItem: 'PARENT12' })).toBe(false);
+ expect(canRetrieveAttachmentMetadata({ ...attachment, deleted: 1 })).toBe(false);
+ expect(canRetrieveAttachmentMetadata({ itemType: 'note' })).toBe(false);
+});
+
+test('compares bibliographic metadata without offering to replace user-managed data', () => {
+ const current = {
+  itemType: 'journalArticle', title: 'Current title', abstractNote: 'Keep this summary', DOI: '',
+  creators: [{ creatorType: 'author', firstName: 'Current', lastName: 'Author' }],
+  tags: [{ tag: 'keep-me' }], collections: ['COLLECTION'], relations: { related: ['x'] },
+  dateAdded: '2026-01-01T00:00:00Z', version: 12,
+ };
+ const candidate = {
+  itemType: 'journalArticle', title: 'New title', DOI: '10.1234/new',
+  creators: [{ creatorType: 'author', firstName: 'New', lastName: 'Author' }],
+  tags: [{ tag: 'automatic' }], collections: [],
+ };
+ const changes = buildMetadataRefreshChanges(current, candidate);
+ expect(changes.map(change => change.field)).toEqual(['title', 'creators', 'abstractNote', 'DOI']);
+ expect(changes.find(change => change.field === 'DOI').useNewByDefault).toBe(true);
+ expect(changes.find(change => change.field === 'title').useNewByDefault).toBe(false);
