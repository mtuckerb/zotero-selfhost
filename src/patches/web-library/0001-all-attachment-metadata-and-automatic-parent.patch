--- /dev/null
+++ b/src/js/component/modal/metadata-refresh.jsx
@@ -0,0 +1,143 @@
+import cx from 'classnames';
+import { Fragment, memo, useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import { Button, Icon, Spinner } from 'web-common/components';
+import { useDispatch, useSelector } from 'react-redux';
+
+import Modal from '../ui/modal';
+import { applyMetadataRefresh, previewMetadataRefresh, toggleModal } from '../../actions';
+import { focusOnModalOpen } from '../../common/modal-focus';
+import { METADATA_REFRESH } from '../../constants/modals';
+
+const EMPTY = <span className="metadata-refresh-empty">Empty</span>;
+
+const MetadataRefreshModal = () => {
+	const dispatch = useDispatch();
+	const isOpen = useSelector(state => state.modal.id === METADATA_REFRESH);
+	const parentItemKey = useSelector(state => state.modal.parentItemKey);
+	const libraryKey = useSelector(state => state.modal.libraryKey);
+	const isTouchOrSmall = useSelector(state => state.device.isTouchOrSmall);
+	const itemFields = useSelector(state => state.meta.itemFields);
+	const itemTypes = useSelector(state => state.meta.itemTypes);
+	const closeButtonRef = useRef(null);
+	const [preview, setPreview] = useState(null);
+	const [selectedFields, setSelectedFields] = useState(new Set());
+	const [isLoading, setIsLoading] = useState(false);
+	const [isApplying, setIsApplying] = useState(false);
+	const [error, setError] = useState(null);
+
+	useEffect(() => {
+		if (!isOpen) return undefined;
+		let active = true;
+		setPreview(null);
+		setSelectedFields(new Set());
+		setError(null);
+		setIsLoading(true);
+		dispatch(previewMetadataRefresh(parentItemKey, libraryKey)).then(result => {
+			if (!active) return;
+			setPreview(result);
+			setSelectedFields(new Set(result.changes.filter(change => change.useNewByDefault).map(change => change.field)));
+		}).catch(reason => {
+			if (active) setError(reason?.message || 'Metadata could not be refreshed.');
+		}).finally(() => {
+			if (active) setIsLoading(false);
+		});
+		return () => { active = false; };
+	}, [dispatch, isOpen, libraryKey, parentItemKey]);
+
+	const fieldLabels = useMemo(() => Object.fromEntries(itemFields.map(({ field, localized }) => [field, localized])), [itemFields]);
+	const itemTypeLabels = useMemo(() => Object.fromEntries(itemTypes.map(({ itemType, localized }) => [itemType, localized])), [itemTypes]);
+	const getFieldLabel = useCallback(field => field === 'itemType' ? 'Item Type'
+		: field === 'creators' ? 'Creators'
+			: fieldLabels[field] || field.replace(/([a-z])([A-Z])/g, '$1 $2').replace(/^./, value => value.toUpperCase()), [fieldLabels]);
+	const formatValue = useCallback((field, value) => {
+		if (value === undefined || value === null || value === '' || (Array.isArray(value) && value.length === 0)) return EMPTY;
+		if (field === 'itemType') return itemTypeLabels[value] || value;
+		if (field === 'creators') return value.map(creator => creator.name
+			|| [creator.firstName, creator.lastName].filter(Boolean).join(' ')).filter(Boolean).join('; ') || EMPTY;
+		if (Array.isArray(value)) return value.map(entry => typeof entry === 'string' ? entry : JSON.stringify(entry)).join('; ');
+		if (typeof value === 'object') return JSON.stringify(value);
+		return String(value);
+	}, [itemTypeLabels]);
+
+	const handleCancel = useCallback(() => {
+		if (!isApplying) dispatch(toggleModal());
+	}, [dispatch, isApplying]);
+	const handleAfterOpen = useCallback(({ contentEl }) => {
+		focusOnModalOpen(contentEl, isTouchOrSmall, () => closeButtonRef.current?.focus({ preventScroll: true }));
+	}, [isTouchOrSmall]);
+	const toggleField = useCallback(field => {
+		setSelectedFields(current => {
+			const next = new Set(current);
+			if (next.has(field)) next.delete(field);
+			else next.add(field);
+			return next;
+		});
+	}, []);
+	const applyFields = useCallback(async fields => {
+		if (!preview || fields.length === 0) return;
+		setError(null);
+		setIsApplying(true);
+		try {
+			await dispatch(applyMetadataRefresh(parentItemKey, preview.candidate, fields, libraryKey, preview.parentItem));
+			dispatch(toggleModal());
+		} catch (reason) {
+			setError(reason?.message || 'The selected metadata could not be applied.');
+			setIsApplying(false);
+		}
+	}, [dispatch, libraryKey, parentItemKey, preview]);
+	const handleApplySelected = useCallback(() => applyFields([...selectedFields]), [applyFields, selectedFields]);
+	const handleUseAllNew = useCallback(() => applyFields(preview?.changes.map(change => change.field) || []), [applyFields, preview]);
+
+	return (
+		<Modal
+			className="metadata-refresh-modal"
+			contentLabel="Refresh Metadata"
+			isOpen={isOpen}
+			onAfterOpen={handleAfterOpen}
+			onRequestClose={handleCancel}
+			overlayClassName={cx('modal-centered', { 'modal-slide': isTouchOrSmall })}
+			shouldCloseOnEsc={!isApplying}
+			shouldCloseOnOverlayClick={!isApplying}
+		>
+			<Fragment>
+				<div className="modal-header">
+					<h4 className="modal-title truncate">Refresh Metadata</h4>
+					<Button icon className="close" disabled={isApplying} onClick={handleCancel} ref={closeButtonRef} title="Close Dialog">
+						<Icon type="16/close" width="16" height="16" />
+					</Button>
+				</div>
+				<div className="modal-body">
+					{isLoading && <div className="metadata-refresh-status" role="status"><Spinner /> Looking up metadata...</div>}
+					{error && <div className="alert alert-danger" role="alert">{error}</div>}
+					{preview?.warning && <div className="alert alert-warning">{preview.warning}</div>}
+					{preview && preview.changes.length === 0 && <div role="status">Metadata is already up to date.</div>}
+					{preview?.changes.length > 0 && (
+						<div className="metadata-refresh-table-wrap">
+							<table className="metadata-refresh-table">
+								<thead><tr><th scope="col">Use New</th><th scope="col">Field</th><th scope="col">Current</th><th scope="col">New</th></tr></thead>
+								<tbody>{preview.changes.map(change => {
+									const label = getFieldLabel(change.field);
+									return <tr key={change.field}>
+										<td><input type="checkbox" aria-label={`Use new ${label}`} checked={selectedFields.has(change.field)} disabled={isApplying} onChange={() => toggleField(change.field)} /></td>
+										<th scope="row">{label}</th>
+										<td>{formatValue(change.field, change.currentValue)}</td>
+										<td>{formatValue(change.field, change.newValue)}</td>
+									</tr>;
+								})}</tbody>
+							</table>
+						</div>
+					)}
+				</div>
+				<div className="modal-footer">
+					<div className="modal-footer-left"><Button className="btn btn-link" disabled={isApplying} onClick={handleCancel}>Cancel</Button></div>
+					<div className="modal-footer-right">
+						<Button className="btn btn-outline-secondary" disabled={isLoading || isApplying || !preview?.changes.length} onClick={handleUseAllNew}>Use All New</Button>
+						<Button className="btn btn-primary" disabled={isLoading || isApplying || selectedFields.size === 0} onClick={handleApplySelected}>Apply Selected</Button>
+					</div>
+				</div>
+			</Fragment>
+		</Modal>
+	);
+};
+
+export default memo(MetadataRefreshModal);
