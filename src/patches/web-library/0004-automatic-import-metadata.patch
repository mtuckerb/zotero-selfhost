+/* @jest-environment ./test/utils/zotero-env.js */
+import { http, HttpResponse } from 'msw';
+import { setupServer } from 'msw/node';
+import { setupStore } from '../src/js/store';
+import { createAttachments, createAttachmentsFromDropped } from '../src/js/actions/items-write';
+import { retrieveMetadata } from '../src/js/actions/recognize';
+import { JSONtoState } from './utils/state';
+import { setupMSWLifecycle } from './utils/msw-lifecycle';
+import stateRaw from './fixtures/state/desktop-test-user-top-level-attachment-view.json';
+import template from './fixtures/response/new-item-file-attachment.json';
+import created from './fixtures/response/test-user-add-new-attachment-file.json';
+
+jest.mock('../src/js/actions/recognize', () => ({
+ ...jest.requireActual('../src/js/actions/recognize'),
+ retrieveMetadata: jest.fn(() => ({ type: 'TEST_RETRIEVE_METADATA' })),
+}));
+
+const server = setupServer();
+setupMSWLifecycle(server);
+
+test.each([
+ ['button', 'application/pdf', null, false],
+ ['drop', 'application/epub+zip', null, false],
+ ['button', 'text/plain', null, false],
+ ['button', 'application/pdf', 'PARENT01', false],
+ ['button', 'application/pdf', null, true],
+])('%s import of %s, parent=%s, upload failure=%s', async (source, contentType, parentItem, fail) => {
+ const store = setupStore(JSONtoState(stateRaw));
+ let uploaded = false;
+ retrieveMetadata.mockClear();
+ retrieveMetadata.mockImplementation(() => {
+  expect(uploaded).toBe(true);
+  return { type: 'TEST_RETRIEVE_METADATA' };
+ });
+ server.use(
+  http.get('https://api.zotero.org/items/new', () => HttpResponse.json(template)),
+  http.post('https://api.zotero.org/users/1/items', async ({ request }) => {
+   const [item] = await request.json();
+   const response = JSON.parse(JSON.stringify(created));
+   Object.assign(response.successful[0].data, item);
+   return HttpResponse.json(response);
+  }),
+  http.post('https://api.zotero.org/users/1/items/FFIILLEE/file', () => {
+   if (fail) return new HttpResponse('Upload failed', { status: 400 });
+   uploaded = true;
+   return HttpResponse.json({ exists: 1 });
+  }),
+  http.get('https://api.zotero.org/users/1/items', () => HttpResponse.json([], { headers: { 'Total-Results': '0' } })),
+ );
+ const options = { libraryKey: 'u1', parentItem };
+ const action = source === 'drop'
+  ? createAttachmentsFromDropped([new File(['test'], 'sample.epub', { type: contentType })], options)
+  : createAttachments([{ file: new Uint8Array([1, 2, 3, 4]).buffer, fileName: 'sample', contentType }], options);
+ if (fail) await expect(store.dispatch(action)).rejects.toThrow();
+ else await store.dispatch(action);
+ if (fail || parentItem) expect(retrieveMetadata).not.toHaveBeenCalled();
+ else expect(retrieveMetadata).toHaveBeenCalledWith('FFIILLEE', 'u1');
+});
