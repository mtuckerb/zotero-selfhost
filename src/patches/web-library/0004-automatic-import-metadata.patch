+/* @jest-environment ./test/utils/zotero-env.js */
+import { waitFor } from '@testing-library/react';
+import userEvent from '@testing-library/user-event';
+import { createAttachments, importFromFile } from '../src/js/actions';
+import ImportAction from '../src/js/component/item/actions/import';
+import { renderWithProviders } from './utils/render';
+import { JSONtoState } from './utils/state';
+import stateRaw from './fixtures/state/desktop-test-user-top-level-attachment-view.json';
+
+jest.mock('../src/js/actions', () => ({
+ ...jest.requireActual('../src/js/actions'),
+ createAttachments: jest.fn(() => ({ type: 'TEST_IMPORT_DOCUMENT' })),
+ importFromFile: jest.fn(() => ({ type: 'TEST_IMPORT_BIBLIOGRAPHY' })),
+}));
+
+test.each(['pdf', 'epub', 'docx', 'odt', 'html', 'ris'])('Import button handles %s', async extension => {
+ createAttachments.mockClear();
+ importFromFile.mockClear();
+ const state = JSONtoState(stateRaw);
+ const { container } = renderWithProviders(<ImportAction />, { preloadedState: state });
+ await userEvent.upload(container.querySelector('input'), new File(['test'], `sample.${extension}`));
+ if (extension === 'ris') {
+  await waitFor(() => expect(importFromFile).toHaveBeenCalledTimes(1));
+  expect(createAttachments).not.toHaveBeenCalled();
+ } else {
+  await waitFor(() => expect(createAttachments).toHaveBeenCalledWith(
+   [expect.objectContaining({ fileName: `sample.${extension}` })],
+   { collection: state.current.collectionKey }
+  ));
+  expect(importFromFile).not.toHaveBeenCalled();
+ }
+});
